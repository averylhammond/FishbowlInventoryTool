# No need to track cache files or IDE-specific files
__pycache__/
.vscode/

# Ignore virtual environment and log files
venv/
logs/

# Ignore files generated by PyInstaller and the release script
dist/
build/
*.exe
*.spec
release/

# Ignore Inventory and Turnover files used for testing
InventoryAvailability/*
TurnoverReports/*
# Parked inventory PDFs copied in by copy_resources.sh (excluded from the test)
InventoryAvailabilityPendingParserFix/

# Ignore output files
*.xlsx

# Copy of the submodule's canonical results left behind by running the CI steps locally
canonical_correct_results.txt