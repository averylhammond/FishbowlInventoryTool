# No need to track cache files or IDE-specific files
__pycache__/
.vscode/

# Ignore virtual environment files
venv/

# Ignore files generated by PyInstaller and the release script
dist/
build/
*.exe
*.spec
release/

# Ignore Inventory and Turnover files used for testing
InventoryAvailability/*
TurnoverReports/*

# Ignore output files
*.xlsx